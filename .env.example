# Copy this file to .env and provide your Token Factory credentials.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TEXT_MODEL=nvidia/Nemotron-3_5-Lightning
# Image generation runs locally through ComfyUI by default. Download this
# checkpoint to ComfyUI/models/checkpoints before generating an item.
IMAGE_BACKEND=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_turbo_1.0_fp16.safetensors
# Retained only for IMAGE_BACKEND=nebius.
NEBIUS_IMAGE_MODEL=
# Optional: directory of the installed Isaac mod. Defaults to the repository demo.
ISAAC_MOD_DIRECTORY=
# Optional: Isaac log watched for prompts from the in-game generator.
# Defaults to %USERPROFILE%\Documents\My Games\Binding of Isaac Repentance+\log.txt.
ISAAC_LOG_FILE=
