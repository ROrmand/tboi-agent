{
  "name": "nebius-isaac-item-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bridge": "node bridge/server.mjs",
    "mod:sync": "node bridge/sync-mod.mjs",
    "aisaac:prepare": "node demo/live-sprite-swap/scripts/generate_aisaac_assets.mjs",
    "characters:art": "node demo/live-sprite-swap/scripts/generate_character_art.mjs",
    "repentogon:reset": "node native/reset-repentogon-dll.mjs",
    "repentogon:apply-binding": "node native/apply-repentogon-binding.mjs",
    "mod:sync-safe": "node scripts/safe-sync.mjs",
    "generate": "node bridge/generate.mjs",
    "validate": "node bridge/generate.mjs --dry-run --no-image",
    "conditions:generate": "node scripts/generate-condition-metadata.mjs",
    "conditions:check": "node scripts/generate-condition-metadata.mjs --check",
    "effects:generate": "node scripts/generate-effect-metadata.mjs",
    "effects:check": "node scripts/generate-effect-metadata.mjs --check",
    "powers:generate": "node scripts/power-diversity.mjs --generate-lua",
    "powers:check": "node scripts/power-diversity.mjs --check-lua",
    "powers:batch": "node scripts/power-diversity.mjs --enforce-gates",
    "vanilla:audit": "node scripts/vanilla-audit/cli.mjs",
    "acceptance:live": "node scripts/conditional-acceptance.mjs",
    "test": "npm run conditions:check && npm run effects:check && npm run powers:check && node --test bridge/*.test.mjs native/*.test.mjs native/stage1/*.test.mjs native/ipc/*.test.mjs scripts/*.test.mjs scripts/vanilla-audit/*.test.mjs",
    "native:prepare": "node native/stage1/prepare.mjs",
    "ipc:prepare": "node native/ipc/prepare.mjs",
    "art:prepare": "node native/ipc/prepare-art-slots.mjs",
    "ipc:generate": "node native/ipc/request-profile.mjs",
    "test:native": "node --test native/*.test.mjs native/stage1/*.test.mjs",
    "native:verify": "node native/stage1/verify.mjs"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "wasmoon": "^1.16.0"
  }
}
