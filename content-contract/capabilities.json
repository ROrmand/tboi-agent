    "active_charge_at_least": {
      "summary": "{slot} active normal+battery charge at least {amount}",
      "params": {
        "amount": {
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 99
        },
        "slot": {
          "type": "string",
          "required": true,
          "enum": [
            "primary",
            "secondary",
            "pocket",
            "pocket2"
          ]
        }
      },
      "category": "pure",
      "scope": "event",
      "guidance": "Require an occupied selected slot on the event player and GetActiveCharge(slot) + GetBatteryCharge(slot) >= amount. Slots primary/secondary/pocket/pocket2 map to 0/1/2/3. Never sum across slots, infer the used slot, or count blood/soul/subcharge. Empty slots fail even at zero. Raw charge, not usability/fullness or percent; timed actives retain engine units. Read event-time state without spending charge. Missing or invalid queries fail closed.",
      "requires": [
        "player"
      ],
